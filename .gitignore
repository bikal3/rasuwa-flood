__pycache__/
*.pyc
.DS_Store

# Local tooling config. settings.local.json is covered by the global gitignore
# on this machine, but that does not travel with the repo.
.claude/

# Imagery and derived rasters: ~160 MB of GeoTIFF, all regenerable.
# stage1_export.py rebuilds data/raster + data/vector from Earth Engine;
# stage2_analysis.py rebuilds data/derived from those.
data/*
!data/tables/
data/tables/*
!data/tables/*.csv

# maps/ IS committed -- the PNGs are the readable result, and a reviewer without
# Earth Engine credentials cannot regenerate them.

# Node modules and the built site: both reproducible from web/ with
#   cd web && npm install && node build.mjs
node_modules/
/site/

# web/public/data IS committed, for the same reason maps/ is: it is generated by
# stage4_hot.py from rasters that need Earth Engine credentials, so a reviewer
# without them can still build and serve the site.

# The manuscript draft stays out of the repository until it is ready to be
# submitted. Listed here rather than left merely untracked so that a `git add -A`
# cannot publish a draft with placeholder authors in it.
/paper/
